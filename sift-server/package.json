{
  "name": "@sift/server",
  "version": "0.1.0",
  "description": "Sift Server — MCP security firewall for company-deployed MCP servers.",
  "type": "module",
  "bin": { "sift-server": "dist/sift-server/src/index.js" },
  "files": [
    "dist/",
    "sift-server.config.example.json",
    "README.md"
  ],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc",
    "postbuild": "node ../scripts/add-shebang.mjs dist/sift-server/src/index.js || true",
    "dev": "tsx watch src/index.ts --config ./sift-server.config.example.json",
    "start": "node dist/sift-server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0"
  }
}

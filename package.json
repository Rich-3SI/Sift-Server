{
  "name": "@3rdstar/sift-server",
  "version": "0.1.0",
  "description": "Open-source MCP security gateway for AI agents.",
  "type": "module",
  "bin": {
    "sift-server": "sift-server/dist/sift-server/src/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm --prefix sift-server run build",
    "start": "node sift-server/dist/sift-server/src/index.js",
    "typecheck": "tsc --noEmit && tsc -p sift-server/tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts && node --import tsx --test sift-server/test/*.test.ts",
    "quickstart:test": "node scripts/quickstart-smoke-test.mjs",
    "docker:build": "docker build -f sift-server/Dockerfile ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
